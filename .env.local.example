# Copiar estos 5 valores desde el .env/.env.local local de Morpheus.
# No se leen automaticamente por diseno (son secretos/config de entorno, no codigo fuente).
NEXT_PUBLIC_AWS_ENDPOINT=
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_AWS_DEFAULTAUTHMODE=
NEXT_PUBLIC_AWS_API_KEY=
NEXT_PUBLIC_AWS_WSS_ENDPOINT=

# Copiar del panel de Clerk; la secret key nunca lleva NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
